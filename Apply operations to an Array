class Solution:
    def applyOperations(self, nums):
        # Step 1: Apply operations
        for i in range(len(nums) - 1):
            if nums[i] == nums[i + 1]:
                nums[i] *= 2
                nums[i + 1] = 0

        # Step 2: Move non-zero elements forward
        pos = 0
        for i in range(len(nums)):
            if nums[i] != 0:
                nums[pos] = nums[i]
                pos += 1

        # Step 3: Fill remaining with zeros
        for i in range(pos, len(nums)):
            nums[i] = 0

        return nums
